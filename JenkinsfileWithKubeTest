pipeline {

    agent any

    environment {
        PATH = "/usr/local/bin:${env.PATH}"
    }

    stages {

        stage('Checkout') {
            steps {
               steps {
                git branch: 'main', url:'https://github.com/sreenivas-shamala/selenium_jenkins_integration.git'
                
            }
            }
        }

        stage('Test Kubernetes') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k8s_config',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=== kubectl ==="
                        which kubectl
                        kubectl version --client

                        echo "=== Context ==="
                        kubectl config current-context

                        echo "=== Nodes ==="
                        kubectl get nodes
                    '''
                }
            }
        }

       

      

        stage('Build Selenium Docker Image') {
            steps {
                sh '''
                    docker build -t selenium-tests:v1 .
                '''
            }
        }

        stage('Run Selenium Tests') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k8s_config',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=== Delete previous Selenium Job ==="
                        kubectl delete job selenium-test --ignore-not-found=true

                        echo "=== Start Selenium Job ==="
                        kubectl apply -f selenium-jenkins-app.yaml

                        echo "=== Wait for Selenium tests ==="
                        kubectl wait --for=condition=complete job/selenium-test --timeout=300s
                    '''
                }
            }
        }

        stage('Selenium Test Logs') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k8s_config',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        kubectl logs job/selenium-test
                    '''
                }
            }
        }
    }

    post {

        always {
            echo 'Pipeline completed'
        }

        success {
            echo 'Selenium tests passed'
        }

        failure {
            echo 'Selenium tests failed'
        }
    }
}
